---
import { faq, sections } from '../data/site';

// The id is "support", not "faq": the App Store listing's support URL is /#support.
---

<section id="support" class="faq-section">
  <div class="container">
    <div class="section-header">
      <h2>{sections.support.title}</h2>
      <p class="section-description">{sections.support.description}</p>
    </div>
    <div class="faq-accordion">
      {
        faq.map((entry) => (
          // The shared name makes the browser close the open entry when another one opens.
          <details name="faq" class="faq-item">
            <summary>{entry.question}</summary>
            <div class="faq-body">
              <p class="faq-answer">{entry.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
